# Supabase PostgreSQL connection string
# Supabase 대시보드 → Project Settings → Database → Connection string (Transaction pooler)
# 아래 값을 실제 connection string으로 교체하고 이 파일을 .env 로 복사하세요.
#   cp .env.example .env
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR_PASSWORD@aws-1-us-east-1.pooler.supabase.com:6543/postgres

# (선택) 서버 포트. 미설정 시 3000 사용
# PORT=3000
